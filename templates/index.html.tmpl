<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>myip</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<style>
  :root {
    color-scheme: dark;
    --bg: #0a0c10;
    --panel: #12151c;
    --border: rgba(255, 255, 255, 0.08);
    --text: #e6e8eb;
    --muted: #7d8590;
    --accent: #c9a6ff;
    --accent-ink: #1a0b2e;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0;
    min-height: 100%;
    background: var(--bg);
    color: var(--text);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 16px;
  }
  .card {
    width: 100%;
    max-width: 520px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 40px 32px 28px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 999px;
    margin-bottom: 20px;
  }
  .ip {
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-align: center;
    word-break: break-all;
    cursor: pointer;
    margin-bottom: 6px;
  }
  .hostname {
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
    word-break: break-all;
    margin-bottom: 4px;
  }
  .hint {
    text-align: center;
    color: var(--muted);
    font-size: 0.7rem;
    margin-bottom: 8px;
  }
  section { margin-top: 28px; }
  section:first-of-type { margin-top: 32px; }
  hr {
    border: none;
    border-top: 1px dashed var(--border);
    margin: 28px 0 0;
  }
  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    row-gap: 10px;
    column-gap: 16px;
    margin: 16px 0 0;
  }
  dt { color: var(--muted); }
  dd {
    margin: 0;
    text-align: right;
    word-break: break-all;
  }
  footer {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px dashed var(--border);
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 0.65rem;
    color: var(--muted);
  }
  .github {
    color: var(--muted);
    transition: color 0.15s;
  }
  .github:hover { color: var(--fg); }
  .github svg { display: block; width: 22px; height: 22px; }
</style>
</head>
<body>
  <div class="card">
    <span class="badge">who am i?</span>
    <div class="ip" id="ip" title="click to copy">{{.IP}}</div>
    {{if .Hostname}}<div class="hostname">{{.Hostname}}</div>{{end}}
    <div class="hint" id="copy-hint">click to copy</div>

    <hr>
    <section>
      <span class="badge">request</span>
      <dl>
        <dt>Browser</dt><dd>{{.Browser}}</dd>
        <dt>OS</dt><dd>{{.OS}}</dd>
        <dt>Device</dt><dd>{{.Device}}</dd>
        <dt>Protocol</dt><dd>{{.Protocol}}</dd>
        <dt>Language</dt><dd>{{.Language}}</dd>
      </dl>
    </section>

    <hr>
    <section>
      <span class="badge">client</span>
      <dl>
        <dt>Screen</dt><dd id="screen">-</dd>
        <dt>Timezone</dt><dd id="timezone">-</dd>
        <dt>Local time</dt><dd id="localtime">-</dd>
      </dl>
    </section>

    <footer>
      <span>PS: your IP is never stored :)</span>
      <a class="github" href="https://github.com/dbohry/myip" target="_blank" rel="noopener" aria-label="GitHub repository">
        <svg viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
    </footer>
  </div>
  <script>
    document.getElementById('screen').textContent = screen.width + ' x ' + screen.height;
    document.getElementById('timezone').textContent = Intl.DateTimeFormat().resolvedOptions().timeZone;
    document.getElementById('localtime').textContent = new Date().toString();

    document.getElementById('ip').addEventListener('click', function () {
      var hint = document.getElementById('copy-hint');
      navigator.clipboard.writeText(this.textContent.trim()).then(function () {
        var original = hint.textContent;
        hint.textContent = 'copied!';
        setTimeout(function () { hint.textContent = original; }, 1200);
      });
    });
  </script>
</body>
</html>
